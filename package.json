{
  "name": "badges-backend",
  "version": "1.0.0",
  "description": "Backend API for Galicia Badges",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "node --watch --env-file=.env src/server.ts",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "start": "node dist/server.js",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.18.0",
    "oxlint": "^1.51.0",
    "typescript": "^5.9.3"
  }
}
